//create service account
kubectl create serviceaccount sa -n ckad

//create secret with service account
kubectl create secret generic sasecrete --serviceaccount=sa -n ckad --from-literal=name=ooseven

//create pod with secret and service account
kubectl run secpod --image=nginx --port=8080  -n ckad--dry-run=client -o yaml > secpod.yaml

//edit secpod.yaml - add service account and secret 

