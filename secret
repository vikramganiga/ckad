
//create secret
kubectl create secret generic secret1 --from-literal=user=temp --from-literal=pass

//place pod
# cat secretnginx.yaml
apiVersion: v1
kind: Pod
metadata:
  labels:
    run: nginx
  name: nginx
spec:
  containers:
  - image: nginx
    name: nginx
    ports:
    - containerPort: 80
    resources: {}
    env:
    - name: SECRET_USERNAME
      valueFrom:
        secretKeyRef:
          name: secret1
          key: user
    - name: SECRET1_PASS
      valueFrom:
          secretKeyRef:
            name: secret1
            key: pass
  restartPolicy: Always
status: {}
